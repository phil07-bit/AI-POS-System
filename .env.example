# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 16+ (needs the btree_gist extension, created by the migrations)
DATABASE_URL=postgresql://aipos:aipos@localhost:5432/aipos
# Used by `npm test` (integration tests TRUNCATE this database; never point it at real data)
TEST_DATABASE_URL=postgresql://aipos:aipos@localhost:5432/aipos_test

# AES-256-GCM key material for tenant ID numbers. Generate: openssl rand -base64 32
# Changing it makes existing encrypted ID numbers unreadable.
FIELD_ENCRYPTION_KEY=change-me

# Demo mode: shows the demo banner and the /dev/outbox mock email viewer (never in production)
DEMO_MODE=true

# Integration adapters. Only "mock" is implemented in phases 1–3 (see docs/INTEGRATIONS.md).
EMAIL_PROVIDER=mock
AI_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Set only for an isolated demo environment that should accept `npm run db:seed` with NODE_ENV=production
# ALLOW_DEMO_SEED=false

# Reserved for later phases (not read by the code yet):
# AUTH_SECRET=        # sessions use random tokens hashed with sha256, so no signing secret is needed today
# JOB_SECRET=         # for an HTTP-triggered job endpoint; jobs currently run via `npm run jobs:run`
# STORAGE_PROVIDER=local
