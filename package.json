{
  "name": "ai-pos",
  "version": "0.1.0",
  "private": true,
  "description": "AI-POS — AI Property Operating System (MVP: phases 1-4)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed/index.ts",
    "jobs:run": "tsx src/server/jobs/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts",
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.7",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
