// AI-POS database schema — phases 1–3 (foundation, property operations, rent ledger).
// Conventions:
//  * UUID primary keys, snake_case tables/columns via @@map/@map.
//  * Money is stored as integer minor units (pesewas for GHS) in *_minor BigInt-free Int columns.
//    Int (32-bit) holds up to ~GHS 21.4m per row which is ample for individual charges/payments;
//    aggregates are computed in SQL as bigint. See src/lib/money.
//  * Calendar dates (lease dates, charge periods, due dates) use Postgres DATE; instants use timestamptz.
//  * Every organization-owned row carries organization_id and every service query filters on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & workspace ─────────────────────────────

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  legalName       String?  @map("legal_name")
  email           String?
  phone           String?
  countryCode     String   @default("GH") @map("country_code")
  defaultCurrency String   @default("GHS") @map("default_currency")
  timezone        String   @default("Africa/Accra")
  dateFormat      String   @default("dd MMM yyyy") @map("date_format")
  addressJson     Json?    @map("address_json")
  logoStorageKey  String?  @map("logo_storage_key")
  status          String   @default("active") // active | suspended
  plan            String   @default("trial")
  isDemo          Boolean  @default(false) @map("is_demo")
  // Policy settings (organization-configurable)
  paymentsRequireConfirmation Boolean @default(true) @map("payments_require_confirmation")
  chargeGenerationHorizonDays Int     @default(31) @map("charge_generation_horizon_days")
  leaseExpiryWarningDays      Int     @default(60) @map("lease_expiry_warning_days")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships   OrganizationMembership[]
  invitations   Invitation[]
  properties    Property[]
  units         Unit[]
  tenants       Tenant[]
  leases        Lease[]
  rentCharges   RentCharge[]
  payments      Payment[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sequences     OrgSequence[]

  @@map("organizations")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name")
  email            String    @unique // normalized lower-case
  phone            String?
  passwordHash     String?   @map("password_hash") // bcrypt; never plaintext
  status           String    @default("active") // active | disabled
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships    OrganizationMembership[] @relation("MemberUser")
  sessions       Session[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @map("token_hash") // sha256 of the cookie token
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt           DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  userAgent            String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique // e.g. org_owner, finance_officer
  name           String
  description    String?
  organizationId String?  @map("organization_id") @db.Uuid // null = system role; custom roles later
  isSystem       Boolean  @default(true) @map("is_system")
  rank           Int      @default(0) // used to stop admins granting roles above their own
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  permissions RolePermission[]
  memberships OrganizationMembership[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique // e.g. payment.reverse
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  status         String    @default("active") // active | suspended
  // Property scope: when scopeAllProperties is false, access is limited to rows in membership_property_scopes.
  scopeAllProperties Boolean @default(true) @map("scope_all_properties")
  // Tenant portal users are linked to exactly one tenant record.
  tenantId       String?   @map("tenant_id") @db.Uuid
  invitedById    String?   @map("invited_by") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  tenant       Tenant?      @relation(fields: [tenantId], references: [id])
  propertyScopes MembershipPropertyScope[]
  managedProperties Property[] @relation("PropertyManager")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model MembershipPropertyScope {
  membershipId String @map("membership_id") @db.Uuid
  propertyId   String @map("property_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([membershipId, propertyId])
  @@map("membership_property_scopes")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  scopeAllProperties Boolean @default(true) @map("scope_all_properties")
  propertyIds    String[]  @default([]) @map("property_ids") @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("pending") // pending | accepted | revoked | expired
  invitedById    String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, status])
  @@map("invitations")
}

// Per-organization counters for human-readable references (receipt numbers, lease refs...).
model OrgSequence {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("org_sequences")
}

// ───────────────────────────── Property operations ─────────────────────────────

model Property {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  propertyRef          String    @map("property_ref")
  name                 String
  propertyType         String    @map("property_type") // residential | commercial | mixed_use | industrial | land | hospitality | institutional | other
  description          String?
  // Ghana-friendly address: { country, region, district, community, landmark, digitalAddress, notes }
  addressJson          Json      @map("address_json")
  latitude             Decimal?  @db.Decimal(9, 6)
  longitude            Decimal?  @db.Decimal(9, 6)
  ownerNameOrEntity    String?   @map("owner_name_or_entity")
  status               String    @default("active") // active | inactive | under_development | archived
  acquisitionDate      DateTime? @map("acquisition_date") @db.Date
  acquisitionCostMinor Int?      @map("acquisition_cost_minor") // restricted: property.financials.read
  currency             String    @default("GHS")
  managerMembershipId  String?   @map("manager_membership_id") @db.Uuid
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz
  createdById          String?   @map("created_by") @db.Uuid
  updatedById          String?   @map("updated_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      OrganizationMembership? @relation("PropertyManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  units        Unit[]
  leases       Lease[]
  rentCharges  RentCharge[]
  scopes       MembershipPropertyScope[]

  @@unique([organizationId, propertyRef])
  @@index([organizationId, status])
  @@map("properties")
}

model Unit {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  unitRef         String    @map("unit_ref")
  unitName        String    @map("unit_name")
  unitType        String    @map("unit_type") // apartment | studio | chamber_and_hall | single_room | shop | office | warehouse | parking | other
  building        String?
  block           String?
  floor           String?
  bedrooms        Int?
  bathrooms       Int?
  areaValue       Decimal?  @map("area_value") @db.Decimal(10, 2)
  areaUnit        String?   @default("sqm") @map("area_unit")
  furnishingStatus String   @default("unfurnished") @map("furnishing_status") // unfurnished | semi_furnished | furnished
  askingRentMinor Int?      @map("asking_rent_minor")
  currency        String    @default("GHS")
  rentFrequency   String    @default("monthly") @map("rent_frequency")
  // Manual availability override. "occupied" is NOT stored — it is derived from active leases.
  availability    String    @default("available") // available | reserved | unavailable | under_maintenance
  description     String?
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  leases       Lease[]
  rentCharges  RentCharge[]

  @@unique([propertyId, unitRef])
  @@index([organizationId])
  @@map("units")
}

model Tenant {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  tenantRef                String    @map("tenant_ref")
  tenantType               String    @map("tenant_type") // individual | organization
  displayName              String    @map("display_name")
  email                    String?
  phone                    String?   // E.164, e.g. +233241234567
  alternatePhone           String?   @map("alternate_phone")
  addressJson              Json?     @map("address_json")
  emergencyContactJson     Json?     @map("emergency_contact_json") // restricted: tenant.sensitive.read
  identificationType       String?   @map("identification_type") // ghana_card | passport | drivers_licence | voter_id | other
  identificationRefEncrypted String? @map("identification_reference_encrypted") // AES-256-GCM, restricted
  identificationRefLast4   String?   @map("identification_reference_last4")
  employmentInfo           String?   @map("employment_info") // optional; restricted
  status                   String    @default("prospective") // prospective | active | former
  privacyNoticeVersion     String?   @map("privacy_notice_version")
  privacyNoticeAcceptedAt  DateTime? @map("privacy_notice_accepted_at") @db.Timestamptz
  archivedAt               DateTime? @map("archived_at") @db.Timestamptz
  createdById              String?   @map("created_by") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseParties LeaseParty[]
  notes        TenantNote[]
  rentCharges  RentCharge[]
  payments     Payment[]
  adjustments  LedgerAdjustment[]
  portalMemberships OrganizationMembership[]

  @@unique([organizationId, tenantRef])
  @@index([organizationId, status])
  @@map("tenants")
}

model TenantNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  kind           String   @default("note") // note | call | visit | email | sms | other
  body           String
  authorUserId   String   @map("author_user_id") @db.Uuid
  authorName     String   @map("author_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_notes")
}

model Lease {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  leaseRef           String    @map("lease_ref")
  propertyId         String    @map("property_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date // inclusive
  rentAmountMinor    Int       @map("rent_amount_minor") // amount per billing period
  currency           String    @default("GHS")
  billingFrequency   String    @map("billing_frequency") // monthly | quarterly | half_yearly | yearly | custom
  dueDay             Int?      @map("due_day") // day of month; null = first day of period
  depositAmountMinor Int       @default(0) @map("deposit_amount_minor")
  depositStatus      String    @default("not_applicable") @map("deposit_status") // not_applicable | pending | held | refunded | applied
  advanceMonths      Int?      @map("advance_months") // informational: months of rent advance agreed
  gracePeriodDays    Int       @default(0) @map("grace_period_days")
  lateFeeEnabled     Boolean   @default(false) @map("late_fee_enabled") // disabled by default; no automatic penalties
  noticePeriodDays   Int?      @map("notice_period_days")
  renewalTerms       String?   @map("renewal_terms")
  status             String    @default("draft") // draft | pending_signature | active | expired | terminated
  signedDocumentId   String?   @map("signed_document_id") @db.Uuid
  renewalOfLeaseId   String?   @map("renewal_of_lease_id") @db.Uuid
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz
  activatedById      String?   @map("activated_by") @db.Uuid
  terminatedAt       DateTime? @map("terminated_at") @db.Date // effective termination date
  terminationReason  String?   @map("termination_reason")
  settlementNotes    String?   @map("settlement_notes")
  internalNotes      String?   @map("internal_notes")
  createdById        String?   @map("created_by") @db.Uuid
  updatedById        String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renewalOf    Lease?       @relation("LeaseRenewal", fields: [renewalOfLeaseId], references: [id])
  renewals     Lease[]      @relation("LeaseRenewal")
  parties      LeaseParty[]
  rentCharges  RentCharge[]
  payments     Payment[]
  adjustments  LedgerAdjustment[]

  @@unique([organizationId, leaseRef])
  @@index([organizationId, status])
  @@index([unitId, status])
  @@map("leases")
}

model LeaseParty {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  leaseId        String  @map("lease_id") @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  partyRole      String  @map("party_role") // primary_tenant | co_tenant | guarantor | occupant
  isPrimary      Boolean @default(false) @map("is_primary")

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([leaseId, tenantId, partyRole])
  @@index([tenantId])
  @@map("lease_parties")
}

// ───────────────────────────── Financial ledger ─────────────────────────────

model RentCharge {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  leaseId        String    @map("lease_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid // primary tenant (bill-to)
  propertyId     String    @map("property_id") @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  chargeRef      String    @map("charge_ref")
  chargeType     String    @map("charge_type") // rent | service_charge | utility | other
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  amountMinor    Int       @map("amount_minor")
  currency       String    @default("GHS")
  // Cached status, recomputed from allocations/credits after every ledger change (source of truth = ledger rows).
  status         String    @default("due") // due | partially_paid | paid | overdue | void
  description    String?
  source         String    @default("manual") // generated | manual
  idempotencyKey String?   @map("idempotency_key")
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz
  voidReason     String?   @map("void_reason")
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]
  adjustments  LedgerAdjustment[]

  // Duplicate-prevention for generated (and manual) charges.
  @@unique([leaseId, chargeType, periodStart])
  @@unique([organizationId, chargeRef])
  @@index([organizationId, dueDate])
  @@index([tenantId])
  @@map("rent_charges")
}

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  paymentRef        String    @map("payment_ref")
  tenantId          String    @map("tenant_id") @db.Uuid
  leaseId           String?   @map("lease_id") @db.Uuid
  payerName         String?   @map("payer_name")
  amountMinor       Int       @map("amount_minor")
  currency          String    @default("GHS")
  paymentMethod     String    @map("payment_method") // cash | bank_transfer | mobile_money | cheque | card | other
  receivedAt        DateTime  @map("received_at") @db.Date
  externalReference String?   @map("external_reference") // e.g. MoMo transaction ID; never PINs or card numbers
  status            String    @default("pending") // pending | confirmed | reversed | refunded
  recordedById      String    @map("recorded_by") @db.Uuid
  confirmedById     String?   @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz
  reversedById      String?   @map("reversed_by") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz
  reversalReason    String?   @map("reversal_reason")
  idempotencyKey    String    @map("idempotency_key")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?              @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]
  receipt      Receipt?

  @@unique([organizationId, paymentRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedAt])
  @@index([tenantId])
  @@map("payments")
}

model PaymentAllocation {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  paymentId            String    @map("payment_id") @db.Uuid
  rentChargeId         String    @map("rent_charge_id") @db.Uuid
  allocatedAmountMinor Int       @map("allocated_amount_minor")
  method               String    @default("auto") // auto (oldest-due-first) | manual
  // Reversal never deletes: the allocation row is retained and marked reversed.
  reversedAt           DateTime? @map("reversed_at") @db.Timestamptz
  reversedById         String?   @map("reversed_by") @db.Uuid
  createdById          String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  rentCharge RentCharge @relation(fields: [rentChargeId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([rentChargeId])
  @@map("payment_allocations")
}

model LedgerAdjustment {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  adjustmentRef         String   @map("adjustment_ref")
  tenantId              String   @map("tenant_id") @db.Uuid
  leaseId               String?  @map("lease_id") @db.Uuid
  rentChargeId          String?  @map("rent_charge_id") @db.Uuid // credits may target a specific charge
  adjustmentType        String   @map("adjustment_type") // credit | refund | reversal
  amountMinor           Int      @map("amount_minor")
  currency              String   @default("GHS")
  reason                String
  reference             String?
  reversesTransactionId String?  @map("reverses_transaction_id") @db.Uuid // payment id for reversals
  approvedById          String?  @map("approved_by") @db.Uuid
  createdById           String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease      Lease?      @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  rentCharge RentCharge? @relation(fields: [rentChargeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, adjustmentRef])
  @@index([tenantId])
  @@map("ledger_adjustments")
}

model Receipt {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  receiptNumber      String   @map("receipt_number")
  paymentId          String   @unique @map("payment_id") @db.Uuid
  issuedAt           DateTime @default(now()) @map("issued_at") @db.Timestamptz
  issuedById         String?  @map("issued_by") @db.Uuid
  documentStorageKey String?  @map("document_storage_key")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@map("receipts")
}

// ───────────────────────────── Governance ─────────────────────────────

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorName      String?  @map("actor_name")
  action         String   // e.g. payment.reversed
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  summary        String?
  beforeJson     Json?    @map("before_json") // redacted
  afterJson      Json?    @map("after_json")  // redacted
  metadataJson   Json?    @map("metadata_json")
  requestId      String?  @map("request_id")
  isDemo         Boolean  @default(false) @map("is_demo")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  recipient       String    // email address or user id
  eventType       String    @map("event_type")
  channel         String    // in_app | email
  subject         String
  body            String
  bodyTemplateKey String?   @map("body_template_key")
  provider        String    @default("mock")
  status          String    @default("pending") // pending | sent | simulated | failed | read
  idempotencyKey  String    @unique @map("idempotency_key")
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  readAt          DateTime? @map("read_at") @db.Timestamptz
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  jobName    String    @map("job_name")
  status     String    // running | succeeded | failed
  countsJson Json?     @map("counts_json")
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  @@index([jobName, startedAt])
  @@map("job_runs")
}
